{
  "manifest_version": 3,
  "name": "WhatsApp Integration - Kanban CastTaskManager",
  "version": "1.0.0",
  "description": "Cria de forma instantânea tarefas no seu painel Kanban selecionando mensagens no WhatsApp Web.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://web.whatsapp.com/*",
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_end"
    }
  ]
}
